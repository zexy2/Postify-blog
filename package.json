{
  "name": "postify",
  "private": true,
  "version": "0.1.0",
  "description": "Verified knowledge network for developers — reproducible guides, evidence, freshness signals, and community validation.",
  "type": "module",
  "homepage": "https://postify.zekiakgul.dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zexy2/postify.git"
  },
  "bugs": {
    "url": "https://github.com/zexy2/postify/issues"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:build": "node scripts/verify-build.mjs",
    "verify": "npm run verify:knowledge && npm test && npm run lint && npm run build && npm run smoke:build",
    "test:e2e:ui": "playwright test e2e/ui-v2.spec.js --project=chromium",
    "verify:knowledge": "node scripts/verify-knowledge.mjs",
    "knowledge:artifacts": "node scripts/generate-knowledge-artifacts.mjs",
    "predev": "npm run verify:knowledge && npm run runtime:status && npm run knowledge:artifacts",
    "prebuild": "npm run verify:knowledge && npm run runtime:status && npm run knowledge:artifacts",
    "export:knowledge": "node scripts/export-supabase-knowledge.mjs",
    "verify:security": "node scripts/verify-release-security.mjs",
    "runtime:status": "node scripts/refresh-runtime-status.mjs",
    "test:e2e:visual": "playwright test -c playwright.visual.config.js"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@reduxjs/toolkit": "^2.11.2",
    "@supabase/supabase-js": "^2.91.0",
    "@tanstack/react-query": "^5.90.19",
    "@tiptap/extension-placeholder": "^3.16.0",
    "@tiptap/markdown": "3.16.0",
    "@tiptap/react": "^3.16.0",
    "@tiptap/starter-kit": "^3.16.0",
    "axios": "^1.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "gradflow": "^0.2.0",
    "i18next": "^25.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-helmet-async": "^3.0.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^16.5.3",
    "react-icons": "^5.7.0",
    "react-is": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.7.1",
    "redux-persist": "^6.0.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@playwright/test": "1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "gh-pages": "^6.3.0",
    "globals": "^16.3.0",
    "jsdom": "^27.4.0",
    "vite": "^7.0.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.17",
    "workbox-window": "^7.4.0"
  }
}
